pipeline {
  agent any

  environment {
    AWS_REGION = "ap-southeast-1"
    EKS_CLUSTER_NAME = "blog-cv-cluster"
    K8S_NAMESPACE = "webapps"
    K8S_DEPLOYMENT = "blog-cv"
    K8S_CONTAINER = "blog-cv"
    ECR_REPOSITORY_NAME = "blog-cv-app"
    IMAGE_TAG = "${BUILD_NUMBER}"
  }

  // CI stages for building, testing, and pushing the Docker image to ECR, then deploying to EKS
  stages {
    stage("Install Dependencies") {
      steps {
        dir("personal-blog-cv") {
          sh "npm ci"
        }
      }
    }

    stage("Resolve AWS Targets") {
      steps {
        script {
          env.AWS_ACCOUNT_ID = sh(script: "aws sts get-caller-identity --query Account --output text", returnStdout: true).trim()
          env.ECR_REPOSITORY_URL = "${env.AWS_ACCOUNT_ID}.dkr.ecr.${env.AWS_REGION}.amazonaws.com/${env.ECR_REPOSITORY_NAME}"
        }
      }
    }

    stage("Lint") {
      steps {
        dir("personal-blog-cv") {
          sh "npm run lint"
        }
      }
    }

    stage("Typecheck") {
      steps {
        dir("personal-blog-cv") {
          sh "npm run typecheck"
        }
      }
    }

    stage("Build App") {
      steps {
        dir("personal-blog-cv") {
          sh "npm run build"
        }
      }
    }

    stage("Semgrep Scan") {
      steps {
        dir("personal-blog-cv") {
          sh "semgrep scan --config auto --error --json --output semgrep.json || true"
        }
      }
    }

    stage("Trivy FS Scan") {
      steps {
        dir("personal-blog-cv") {
          sh "trivy fs . --severity HIGH,CRITICAL --format table -o fs.html"
        }
      }
    }
    // CI ends
    // CD stages for building the Docker image, scanning it, pushing to ECR, and deploying to EKS
    stage("Docker Build") {
      steps {
        dir("personal-blog-cv") {
          sh "docker build -t $ECR_REPOSITORY_URL:$IMAGE_TAG -t $ECR_REPOSITORY_URL:latest ."
        }
      }
    }

    stage("Trivy Image Scan") {
      steps {
        sh "trivy image --severity HIGH,CRITICAL --format table -o image.html $ECR_REPOSITORY_URL:$IMAGE_TAG"
      }
    }

    stage("Push Image To ECR") {
      steps {
        sh '''
          ECR_REGISTRY=$(echo $ECR_REPOSITORY_URL | cut -d/ -f1)
          aws ecr get-login-password --region $AWS_REGION | docker login --username AWS --password-stdin $ECR_REGISTRY
        '''
        sh 'docker push $ECR_REPOSITORY_URL:$IMAGE_TAG'
        sh 'docker push $ECR_REPOSITORY_URL:latest'
      }
    }

    stage("K8s Deploy") {
      steps {
        sh 'aws eks --region $AWS_REGION update-kubeconfig --name $EKS_CLUSTER_NAME'
        sh 'kubectl create namespace $K8S_NAMESPACE --dry-run=client -o yaml | kubectl apply -f -'
        sh 'sed "s|IMAGE_PLACEHOLDER|$ECR_REPOSITORY_URL:$IMAGE_TAG|g" k8s/deployment-service.yml | kubectl apply -f -'
      }
    }

    stage("K8s Verify") {
      steps {
        sh 'kubectl rollout status deployment/$K8S_DEPLOYMENT -n $K8S_NAMESPACE --timeout=180s'
        sh 'kubectl get pods,svc -n $K8S_NAMESPACE'
      }
    }
    // CD ends
  }

  post {
    always {
      archiveArtifacts artifacts: "personal-blog-cv/fs.html,personal-blog-cv/semgrep.json,image.html", allowEmptyArchive: true
    }
  }
}
